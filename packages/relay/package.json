{
  "name": "@tarot/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebSocket relay for table play between browsers: a Cloudflare Worker and Durable Object wrapped around the pure routing logic in src/room.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
